<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "programs" for the MediaDeck project (pasted into SignPath's project settings).
     The release workflow sends MediaDeck's own programs only: MediaDeck.exe and the helpers built from launcher\*.cs.
     7-Zip, mpv, FFmpeg, Streamlink and Electron's DLLs are not ours and are not signed.
     Every file must say product "MediaDeck" and the release's version (the workflow passes it, e.g. 1.0.22.0). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="MediaDeck.exe" product-name="MediaDeck" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <directory path="resources/tools">
      <pe-file path="keys.exe" product-name="MediaDeck" product-version="${version}">
        <authenticode-sign />
      </pe-file>
      <pe-file path="padwatch.exe" product-name="MediaDeck" product-version="${version}">
        <authenticode-sign />
      </pe-file>
      <pe-file path="cursorhide.exe" product-name="MediaDeck" product-version="${version}">
        <authenticode-sign />
      </pe-file>
    </directory>
  </zip-file>
</artifact-configuration>
